<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>local-whisper-mcp</AssemblyName>
    <RootNamespace>LocalWhisperMcp</RootNamespace>
    <Version>1.1.0</Version>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LocalWhisperMcp.Tests" />
    <InternalsVisibleTo Include="hints-eval" />
  </ItemGroup>

  <!-- The licenses travel with every published copy, including the Claude Desktop extension. -->
  <ItemGroup>
    <None Include="..\..\LICENSE;..\..\THIRD-PARTY-NOTICES.txt" Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    The Whisper.net runtime packages copy the native libraries of every platform into the output.
    A build for one RID keeps only that platform's libraries: runtimes/<platform>/ for the CPU and
    runtimes/<backend>/<platform>/ for GPU backends. Whisper.net names macOS folders macos-*.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <WhisperPlatform>$(RuntimeIdentifier.Replace('osx-', 'macos-'))</WhisperPlatform>
  </PropertyGroup>

  <Target Name="KeepWhisperRuntimesOfTargetPlatform" BeforeTargets="AssignTargetPaths" Condition="'$(WhisperPlatform)' != ''">
    <ItemGroup>
      <_OtherWhisperRuntimeFile Include="@(None)" Condition="$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/')) and !$([System.String]::Copy('%(None.TargetPath)').Contains('/$(WhisperPlatform)/'))" />
      <_OtherWhisperRuntimeFile Include="@(None)" Condition="'%(None.TargetPath)' == 'ggml-metal.metal' and !$(RuntimeIdentifier.StartsWith('osx-'))" />
      <None Remove="@(_OtherWhisperRuntimeFile)" />
    </ItemGroup>
  </Target>

  <!--
    transcribe.cpp, which runs Parakeet models, has no NuGet package. Its Python wheels ship the
    native library and its backend modules as built by its authors, so the build downloads the
    wheel of the target RID once, checks it against the SHA-256 that PyPI lists, and copies its
    libraries to runtimes/transcribe/<rid>/. They load each other from that folder ($ORIGIN on
    Linux, @loader_path on macOS), so they stay together. The server checks the version at run
    time, so a new version means changing these properties and Native.SupportedVersion together.
    A build without a RID uses the SDK's own. A RID without a wheel, such as win-arm64, builds
    without the libraries, and a Parakeet model there reports that this build doesn't include them.
  -->
  <PropertyGroup>
    <TranscribeCppVersion>0.4.1</TranscribeCppVersion>
    <TranscribeCppPackages>https://files.pythonhosted.org/packages</TranscribeCppPackages>
    <_TranscribeCppTarget>$(RuntimeIdentifier)</_TranscribeCppTarget>
    <_TranscribeCppTarget Condition="'$(_TranscribeCppTarget)' == ''">$(NETCoreSdkRuntimeIdentifier)</_TranscribeCppTarget>
  </PropertyGroup>
  <Choose>
    <When Condition="'$(_TranscribeCppTarget)' == 'win-x64'">
      <PropertyGroup>
        <TranscribeCppWheelUrl>$(TranscribeCppPackages)/b3/d9/41cbb7195f0fbcf3fea8675da8e597b3b2fc5b553a754120823c62d2f54a/transcribe_cpp_native-0.4.1-py3-none-win_amd64.whl</TranscribeCppWheelUrl>
        <TranscribeCppWheelSha256>ed0df2783c70c08eca406cbab5b79e2f0da3cac575cbc562b402b953fff508df</TranscribeCppWheelSha256>
      </PropertyGroup>
    </When>
    <When Condition="'$(_TranscribeCppTarget)' == 'linux-x64'">
      <PropertyGroup>
        <TranscribeCppWheelUrl>$(TranscribeCppPackages)/89/90/745a4c6bf068a4aec400e32f81f6607475ca4dde8810f6c5c91534201cfa/transcribe_cpp_native-0.4.1-py3-none-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl</TranscribeCppWheelUrl>
        <TranscribeCppWheelSha256>80011910fdc45adfeb78bf1a0e8813e9ad8be54b4f135b20e815388a11e78a50</TranscribeCppWheelSha256>
      </PropertyGroup>
    </When>
    <When Condition="'$(_TranscribeCppTarget)' == 'linux-arm64'">
      <PropertyGroup>
        <TranscribeCppWheelUrl>$(TranscribeCppPackages)/85/26/f70a75ba3a7d6f950dc08e14a877bc811a4b54035d9e847b9ca629d09cde/transcribe_cpp_native-0.4.1-py3-none-manylinux_2_27_aarch64.manylinux_2_28_aarch64.whl</TranscribeCppWheelUrl>
        <TranscribeCppWheelSha256>371e0fd638436123580401284c61610df847d094f5893f38339a6cccd1a16e51</TranscribeCppWheelSha256>
      </PropertyGroup>
    </When>
    <When Condition="'$(_TranscribeCppTarget)' == 'osx-arm64'">
      <PropertyGroup>
        <TranscribeCppWheelUrl>$(TranscribeCppPackages)/ac/bd/92e9e74cf4a59e118fd6b5c65c8f4f3b3c81b7c8030707a6a178764eea3c/transcribe_cpp_native-0.4.1-py3-none-macosx_11_0_arm64.whl</TranscribeCppWheelUrl>
        <TranscribeCppWheelSha256>59fa4672e79cb5282b5d0c435506a22cd47bc6390a6bfee354ba46cae929a7c1</TranscribeCppWheelSha256>
      </PropertyGroup>
    </When>
    <When Condition="'$(_TranscribeCppTarget)' == 'osx-x64'">
      <PropertyGroup>
        <TranscribeCppWheelUrl>$(TranscribeCppPackages)/bd/6b/98d884a92c57b722f8f720e996775425509a82db418a4157a941018f8d67/transcribe_cpp_native-0.4.1-py3-none-macosx_11_0_x86_64.whl</TranscribeCppWheelUrl>
        <TranscribeCppWheelSha256>06d8b7415724a96704630f2056f07d8dd7da4504adaa26edae2de9c97b261d72</TranscribeCppWheelSha256>
      </PropertyGroup>
    </When>
  </Choose>
  <PropertyGroup>
    <TranscribeCppRid Condition="'$(TranscribeCppWheelUrl)' != ''">$(_TranscribeCppTarget)</TranscribeCppRid>
    <TranscribeCppCache>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)transcribe-cpp\$(TranscribeCppVersion)\$(TranscribeCppRid)\</TranscribeCppCache>
  </PropertyGroup>

  <Target Name="AddTranscribeCppRuntime" BeforeTargets="AssignTargetPaths" AfterTargets="KeepWhisperRuntimesOfTargetPlatform" Condition="'$(TranscribeCppRid)' != ''">
    <PropertyGroup>
      <_TranscribeCppWheel>$(TranscribeCppCache)$([System.IO.Path]::GetFileName('$(TranscribeCppWheelUrl)'))</_TranscribeCppWheel>
      <_TranscribeCppExtracted>$(TranscribeCppCache)extracted\</_TranscribeCppExtracted>
    </PropertyGroup>

    <DownloadFile SourceUrl="$(TranscribeCppWheelUrl)" DestinationFolder="$(TranscribeCppCache)" Condition="!Exists('$(_TranscribeCppWheel)')" Retries="3" />
    <GetFileHash Files="$(_TranscribeCppWheel)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_TranscribeCppWheelHash" />
    </GetFileHash>
    <Delete Files="$(_TranscribeCppWheel)" Condition="'$(_TranscribeCppWheelHash.ToLowerInvariant())' != '$(TranscribeCppWheelSha256)'" />
    <Error Condition="'$(_TranscribeCppWheelHash.ToLowerInvariant())' != '$(TranscribeCppWheelSha256)'" Text="The transcribe.cpp wheel from $(TranscribeCppWheelUrl) has SHA-256 $(_TranscribeCppWheelHash), not $(TranscribeCppWheelSha256). The download is deleted; build again to retry." />
    <Unzip SourceFiles="$(_TranscribeCppWheel)" DestinationFolder="$(_TranscribeCppExtracted)" Condition="!Exists('$(_TranscribeCppExtracted)transcribe_cpp_native\_native\contract.json')" />

    <ItemGroup>
      <_TranscribeCppFile Include="$(_TranscribeCppExtracted)transcribe_cpp_native\_native\*.dll;$(_TranscribeCppExtracted)transcribe_cpp_native\_native\*.so;$(_TranscribeCppExtracted)transcribe_cpp_native\_native\*.dylib" />
      <None Include="@(_TranscribeCppFile)" Link="runtimes/transcribe/$(TranscribeCppRid)/%(Filename)%(Extension)" TargetPath="runtimes/transcribe/$(TranscribeCppRid)/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
    <Error Condition="'@(_TranscribeCppFile)' == ''" Text="The transcribe.cpp wheel in $(TranscribeCppCache) has no libraries under transcribe_cpp_native/_native/." />
  </Target>

</Project>
